# Majeedia Trust – static React site on Hostinger (Apache / LiteSpeed)
# Every page is pre-rendered to <page>/index.html, so no PHP or WordPress is
# needed to display the site. Only /api/contact.php runs on the server.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Force HTTPS ---------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- www -> non-www (the site's canonical address) ------------------------
  RewriteCond %{HTTP_HOST} ^www\.majeedia\.org$ [NC]
  RewriteRule ^ https://majeedia.org%{REQUEST_URI} [R=301,L]

  # --- Redirects from old WordPress URLs ------------------------------------
  RewriteRule ^our-projects-v1/?$ /our-work/ [R=301,L]
  RewriteRule ^donate-pages?/?$ /donate/ [R=301,L]
  RewriteRule ^medical-needs-sponsorship/?$ /medical-needs-sponsorship-2/ [R=301,L]
  RewriteRule ^gallery/?$ /about/ [R=301,L]
  RewriteRule ^hello-world/?$ / [R=301,L]
  RewriteRule ^(category|author|tag)/ / [R=301,L]
  RewriteRule ^feed/?$ / [R=301,L]
  RewriteRule ^form/ /contact/ [R=301,L]
  RewriteRule ^(sitemap_index|wp-sitemap|[a-z0-9_-]+-sitemap-?[0-9]*)\.xml$ /sitemap.xml [R=301,L]

  # WordPress admin / login / XML-RPC no longer exist
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [G,L]

  # --- Add a trailing slash to page folders (/about -> /about/) -------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Enable after HTTPS has worked for a few days (browsers remember it for a year):
  # Header always set Strict-Transport-Security "max-age=31536000"

  # --- Caching --------------------------------------------------------------
  # Pages: always check for a new version
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build files (/assets/*): cache for a year
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images: cache for 30 days
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
