# Public URL of the website (used for canonical URLs, hreflang, sitemap and Open Graph).
SITE_URL="https://www.example.org"

# Port the server listens on.
PORT=3000

# Password for the admin panel at /admin. Leave empty to disable the admin panel.
ADMIN_PASSWORD=""

# Secret used to sign admin sessions. Use a long random value (e.g. `openssl rand -hex 32`).
ADMIN_SECRET=""

# Where editable content and uploads are stored. Back these folders up regularly.
DATA_DIR="data"
UPLOAD_DIR="uploads"

# Set when running behind a reverse proxy / load balancer (e.g. "1"), so rate limiting sees real client IPs.
TRUST_PROXY=""
