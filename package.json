{
  "name": "majeedia-trust",
  "private": true,
  "version": "1.0.0",
  "description": "English website and CMS for Majeedia Trust, a family-led charitable initiative.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist dist-ssr"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "compression": "^1.7.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "multer": "^2.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
